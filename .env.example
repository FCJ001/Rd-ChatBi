# ============================================================
# rd-chatBI 环境变量样例
# 用法：cp .env.example .env 然后填真实密钥
# .env 已在 .gitignore 里，绝不提交
# ============================================================

# 应用
APP_NAME=rd-chatBI
# 生产环境务必改为 prod 并把 DEBUG 关掉
APP_ENV=dev
APP_DEBUG=false

# CORS 允许来源（逗号分隔）；"*" 时自动关闭 credentials
CORS_ORIGINS=http://localhost:8003

# ---------------- 认证 ----------------
# header：网关透传 X-User-* 头（仅限开发/内网，网关必须剥离外部传入的身份头）
# jwt：   解析 Authorization: Bearer <token>（生产推荐）
AUTH_MODE=header
# JWT 模式必配（HS256 对称密钥，生产用强随机值）；未配置时 JWT 模式拒绝所有请求
JWT_SECRET=
JWT_ALGORITHM=HS256

# PostgreSQL — 本项目 compose 自带的 chatbi-pg（宿主机端口 15432）
DB_HOST=localhost
DB_PORT=15432
DB_USER=rdagent
DB_PASSWORD=rdagent123
DB_NAME=rd_chatbi
# SQL 回显独立开关（echo 会把含参数的完整 SQL 打进日志，生产必须 false）
DB_ECHO=false

# NL2SQL 查询目标 — demo 医院运营库（scripts/init_demo_data.py 初始化）
DEMO_DB_USER=rdagent
DEMO_DB_PASSWORD=rdagent123
DEMO_DB_NAME=chatbi_demo

# Redis — 本项目 compose 自带的 chatbi-redis（宿主机端口 16379）
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=
REDIS_DB=0

# Milvus — 本项目 compose 自带的 chatbi-milvus（宿主机端口 19531）
MILVUS_HOST=localhost
MILVUS_PORT=19531

# Elasticsearch — 列值召回（本项目 docker-compose 自带 chatbi-es）
ES_HOST=localhost
ES_PORT=9200

# ---------------- 模型 ----------------
# ★ 默认 LLM = DeepSeek。CHAT_API_KEY_ENV 决定从哪个环境变量取 key，
#   和 BASE_URL_CHAT / CHAT_MODEL 必须指向同一服务商（混搭会 401）。
CHAT_API_KEY_ENV=DEEPSEEK_API_KEY
CHAT_MODEL=deepseek-flash
# 轻活模型：3 路关键词扩展 / 表筛选 / 指标筛选 / 图表推荐 / 摘要走这个。
# 留空则全部走 CHAT_MODEL。生成 SQL 与纠错**始终**走 CHAT_MODEL（见 HEAVY_TASKS）。
BASE_URL_CHAT=https://api.deepseek.com/v1

DEEPSEEK_API_KEY=sk-xxxxxxxx
# 已弃用：默认 LLM 走 CHAT_MODEL，本项不再被读取（兼容旧 .env 保留）DEEPSEEK_MODEL=deepseek-chat

# ★ DashScope key 仍然必需：DeepSeek 没有 embedding 接口，向量召回
#   （Milvus 列/指标/示例）走的是 DashScope text-embedding-v3（1024 维）。
#   换 embedding 供应商 = 维度不匹配 + 全部向量重建，不是改配置的事。
DASHSCOPE_API_KEY=sk-xxxxxxxx
EMBEDDING_MODEL=text-embedding-v3

# LLM 请求超时（秒）与重试次数：防 LLM 挂起无限占用 SSE 连接
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=1

# 模型定价（USD/1M tokens，token 计费用）—— 默认 deepseek-chat 官方价
MODEL_PRICING_INPUT=0.15
MODEL_PRICING_OUTPUT=0.60

# API 限流（按 user_id 滑动窗口，查询端点生效）
# RATE_LIMIT_BACKEND=redis（ZSET 跨 worker）/ memory（进程内 deque，仅单 worker 开发）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------- 日志 ----------------
# 生产用 INFO；DEBUG 会打全量节点日志
LOG_LEVEL=INFO
LOG_DIR=logs

# /metrics 保护（可选）：配置后 GET /metrics 要求 Authorization: Bearer <token>
# （Prometheus bearer_token 抓取原生支持）；留空 = 不鉴权，靠内网隔离兜底。
# 生产暴露在非隔离网络时务必配置。
METRICS_TOKEN=

# ---------------- badcase 回流（评测集持续长大） ----------------
# 线上真实查询持续回流成待审案例，人工审过后导出进 eval/cases/*.json
BADCASE_CAPTURE_ENABLED=true
# false（默认）：只收确实答错的（DB 报错/超时/角色拒绝/0 行）。
# true：把 LLM 基础设施故障（熔断/超时/调用失败）也落成 annotate 管道，
# 供审核时区分「该补案例」和「该调 prompt/模型」——默认关，否则会淹没队列
BADCASE_CAPTURE_LLM_ERRORS=false
# 自动采集每数据源/每天上限。★ 必须有：header 模式下 user_id 可伪造，
# 无上限等于对外开一个能刷 PG 的写入口
BADCASE_DAILY_CAP=200

# ---------------- 题库审核（改评测集 = 写权限） ----------------
# ★ 独立于 METRICS_TOKEN：能抓 Prometheus 不该等于能改 golden SQL。
# 留空时：jwt 模式认 role_rules 里值为 all 的角色；header 模式按下面开关处理
ADMIN_TOKEN=
# header 模式（X-User-* 可伪造）且未配 ADMIN_TOKEN 时，审核写接口是否直接拒绝。
# 生产必须 true；本地开发可设 false 免 token 调试
BADCASE_ADMIN_FAIL_CLOSED=true

# ---------------- 对话上下文存储 ----------------
# redis：跨 worker 共享、重启不丢（生产多实例必须用这个）；memory：进程内 dict
# （仅单 worker 开发用，重启即失）
CONVERSATION_BACKEND=redis
# 会话历史 TTL（秒，默认 7 天）。★ 必须有 TTL：header 认证模式下 user_id
# 可伪造，不设过期等于对外提供无上限的写入口
CONVERSATION_MAX_AGE_SECONDS=604800

# ---------------- 数据库连接池 ----------------
# ★ 按 event loop 分区池化（src/infra/pool.py）：同一 loop 内连接复用，
#   跨 loop 隔离 —— asyncpg 连接绑定 event loop，共用会报
#   `Future ... attached to a different loop`。
# DB_POOL_SIZE <= 0 时退回 NullPool（每请求新建连接，排障/对照用）
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---------------- LLM 熔断器 ----------------
# LLM 挂起时每请求都要等满 LLM_REQUEST_TIMEOUT；连续失败到阈值直接快速失败，
# 避免所有并发请求被拖住 + 成本照烧
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=1
